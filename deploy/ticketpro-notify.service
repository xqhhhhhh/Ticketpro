[Unit]
Description=Send TicketPro merchant order notifications to Feishu
After=network-online.target ticketpro.service
Wants=network-online.target

[Service]
Type=oneshot
User=ticketpro
Group=ticketpro-web
WorkingDirectory=/opt/ticketpro
EnvironmentFile=/etc/ticketpro.env
EnvironmentFile=/etc/ticketpro-notify.env
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStart=/opt/ticketpro/.venv/bin/python -m server.notifications --limit 20
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ticketpro

