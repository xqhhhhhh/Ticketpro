[Unit]
Description=TicketPro payment and activation-code delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ticketpro
Group=ticketpro-web
WorkingDirectory=/opt/ticketpro
EnvironmentFile=/etc/ticketpro.env
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0027
ExecStart=/opt/ticketpro/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 18110 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ticketpro /opt/ticketpro-shared

[Install]
WantedBy=multi-user.target
