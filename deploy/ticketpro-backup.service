[Unit]
Description=Back up TicketPro orders and delivery configuration

[Service]
Type=oneshot
User=ticketpro
Group=ticketpro-web
WorkingDirectory=/opt/ticketpro
EnvironmentFile=/etc/ticketpro.env
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStart=/opt/ticketpro/.venv/bin/python -m server.cli backup --directory /var/backups/ticketpro
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/ticketpro
