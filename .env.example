# Local Vite proxy; production can use an HTTPS API origin.
VITE_COMMERCE_API=

# Serve with .venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 18110
TICKETPRO_DB=server/data/shop.sqlite3
TICKETPRO_TUTORIALS=server/tutorials.local.json
TICKETPRO_SITE_URL=https://ticket-pro-website.vercel.app
TICKETPRO_API_URL=https://api.nexuschat.top/ticketpro
TICKETPRO_ORIGINS=https://ticket-pro-website.vercel.app
TICKETPRO_ADMIN_KEY=
ZPAY_PID=
ZPAY_KEY=
ZPAY_CID=25492
TICKETPRO_DEMO=0
# Only trust X-Real-IP from the local Nginx proxy.
TICKETPRO_TRUST_LOOPBACK_PROXY=1
# Existing registry, read only. Never copy its secrets to the website.
UNIFIED_LICENSE_CONFIG=/opt/ticketpro/server/license-projects.json
# Existing license-management credentials; server only, never VITE_*.
TICKETPRO_LICENSE_CONSOLE_KEY=
TICKETPRO_LICENSE_ADMIN_PASSWORD=
# Both services must read this path; it contains code hashes, not activation codes.
UNIFIED_RESERVED_CODES_FILE=/opt/ticketpro-shared/web-reserved-codes.json
